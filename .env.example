# Copy this file to .env and fill in your values
# docker-compose will automatically load .env

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must be at least 256 bits (32+ characters). Generate with:
#   openssl rand -base64 32
JWT_SECRET=change-me-to-a-secure-random-256-bit-secret-before-running

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-db-password

# ── Mail (optional — leave blank to disable email sending) ───────────────────
MAIL_USERNAME=noreply@yourdomain.com
MAIL_PASSWORD=

# ── CORS (comma-separated allowed origins) ───────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000
